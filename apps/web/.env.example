# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/jalajogja

# ── Better Auth ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
BETTER_AUTH_URL=http://localhost:6202
NEXT_PUBLIC_APP_URL=http://localhost:6202

# ── Enkripsi PII (NIK, dst) ────────────────────────────────────────────────────
# Kunci 32-byte, base64. Generate SEKALI per environment (beda antara local dan
# production — JANGAN dipakai ulang), simpan aman, JANGAN pernah commit nilainya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kalau kunci ini hilang, seluruh NIK yang sudah dienkripsi TIDAK BISA dibaca lagi.
MEMBER_PII_ENCRYPTION_KEY=generate-dengan-perintah-di-atas

# ── MinIO — Object Storage (self-hosted) ──────────────────────────────────────
# Development: jalankan dengan `minio server ~/minio-data --console-address :9001`
# Console UI: http://localhost:9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
# URL publik untuk serve file (bisa beda di production jika pakai CDN/nginx proxy)
MINIO_PUBLIC_URL=http://localhost:9000
