# ──────────────────────────────────────────────────────────────────────────────
# jalajogja — Environment Variables
# Copy file ini ke .env.local (di root repo — ini yang dibaca production/VPS,
# lihat docs/panduan-deploy-vps.md § 4.2) dan isi nilainya.
# Generate secret: openssl rand -base64 32
#
# Ini SATU-SATUNYA .env.example yang authoritative untuk project ini — jangan
# duplikasi/pisah ke apps/web/.env.example lagi (riwayat: dua file sempat drift,
# sama-sama tidak lengkap — lihat docs/lessons-learned.md).
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/jalajogja

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://jalakarta.com
NEXT_PUBLIC_APP_URL=https://jalakarta.com
# Origin tambahan yang dipercaya Better Auth (mis. custom domain tenant aktif),
# comma-separated. Kosongkan kalau belum ada custom domain yang butuh cross-origin auth.
BETTER_AUTH_TRUSTED_ORIGINS=

# URL internal yang dipakai server-to-server (middleware/actions memanggil
# /api/internal/resolve-domain sendiri) — biasanya sama dengan NEXT_PUBLIC_APP_URL,
# override HANYA kalau app diakses secara internal lewat host/port berbeda
# (mis. di belakang reverse proxy yang tidak expose port publik langsung).
# APP_INTERNAL_URL=http://localhost:3000

# ── Enkripsi PII (NIK, dst) ────────────────────────────────────────────────────
# Kunci 32-byte, base64. Generate SEKALI per environment (beda antara local dan
# production — JANGAN dipakai ulang), simpan aman, JANGAN pernah commit nilainya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kalau kunci ini hilang, seluruh NIK yang sudah dienkripsi TIDAK BISA dibaca lagi.
MEMBER_PII_ENCRYPTION_KEY=generate-dengan-perintah-di-atas

# ── MinIO — Object Storage (self-hosted) ─────────────────────────────────────
MINIO_ENDPOINT=minio.jalakarta.com
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
# URL publik MinIO yang bisa diakses browser (untuk tampil gambar)
MINIO_PUBLIC_URL=http://minio.jalakarta.com:9000

# ── Platform Admin ────────────────────────────────────────────────────────────
# JWT secret untuk platform dashboard (terpisah dari Better Auth)
PLATFORM_JWT_SECRET=generate-with-openssl-rand-base64-32

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
# Wajib diset di semua environment yang menjalankan endpoint /api/cron/* — semua
# endpoint fail-closed (401) kalau header secret tidak cocok, termasuk saat var
# ini kosong. Generate: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32

# ── RajaOngkir v2 ─────────────────────────────────────────────────────────────
# API key platform — dipakai semua tenant, tidak disimpan di DB
RAJAONGKIR_PLATFORM_KEY=your-rajaongkir-api-key
RAJAONGKIR_PLATFORM_TIER=starter

# ── SMTP / Email ──────────────────────────────────────────────────────────────
# Dipakai lib/mail.ts (mis. notifikasi email, reset password fallback non-WA)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
# Opsional — default fallback ke "Jalakarta" <SMTP_USER> kalau tidak diset
# SMTP_FROM="Jalakarta" <no-reply@jalakarta.com>

# ── WhatsApp Gateway (GOWA, self-hosted) ──────────────────────────────────────
# Docs: docs/arsitektur-whatsapp.md, docs/arsitektur-gowa-deployment.md
WHATSAPP_SERVICE_URL=https://gowa.jalakarta.com
WHATSAPP_API_USER=your-gowa-basic-auth-user
WHATSAPP_API_PASS=your-gowa-basic-auth-password
# Client-side flag murni kosmetik (tampilkan/sembunyikan banner setup di UI admin) —
# BUKAN nilai sensitif, boleh di-set "true" kalau WHATSAPP_SERVICE_URL dkk di atas sudah diisi.
NEXT_PUBLIC_WA_CONFIGURED=

# ── Playwright / PDF Generation ───────────────────────────────────────────────
# Di Docker, pakai chromium system. Di dev lokal, biarkan kosong (playwright download sendiri)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# ── Instagram Graph API (Meta Developer App) ─────────────────────────────────
# Satu Meta App untuk semua tenant — dipakai lewat alur OAuth "Connect Instagram".
# Docs: docs/arsitektur-instagram-embed.md
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# ── Debug (opsional, dev only) ────────────────────────────────────────────────
# Log detail proses upload media anggota — jangan aktifkan di production (bisa verbose)
# DEBUG_UPLOAD=true
