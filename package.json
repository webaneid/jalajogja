{
  "name": "jalajogja",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "turbo": "^2.9.14",
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.0",
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.270"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "trustedDependencies": [
    "@anthropic-ai/claude-code"
  ]
}
